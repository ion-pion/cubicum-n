   CUBICUM N 5 (11 Nov 2026): piece 3, the SHELL, and everything on screen in English
     (Pion: "let's move to the shell, but I want everything in English").
     Home: the Z7 cube (drag it to turn it) and three programs: SYNTH, PLAYER, SHELL.
     The sound flows in every frame, wherever you are.
     Built through CubicumN.Mod, which keeps the app name fixed so the saves stay between versions:
       ollapk Motor2.Mod OllGL4.Mod Synth9.Mod Shell4.Mod CubN5.Mod CubicumN.Mod "Cubicum N"
     Needs the window ecran-gl3-sunet2.dex (GL and streaming sound).
   Earlier: Cubicum N 4 (player), N 3 (no noise on the SOUND tab), N 2 (cube turns both ways), N 1 (cube + synth).
     Pion & Claude, 11.11.2026 *)

  IMPORT Ceas, Math, Motor2, OllGL6, Grafica, Synth9, Shell13, Fs2, Sal4, Scr2, Gazda4, Desk6, Files14, Boot5, Zane4, Juno1, Quince1, Ceres1, Nora18, Herne1;

  CONST
    HOME = 0; SYNTH = 1; PLAYER = 2; SHELL = 3; CANVAS = 4; APPS = 5; FILES = 6; SETTINGS = 7; BOOT = 8;
    TASKS = 9; CALC = 10; CLOCK = 11; IMAGES = 12; HELP = 13; MUSIC = 14; BOOKS = 15; VIDEO = 16; NOTES = 17; RECORDER = 18; BROWSER = 19; HUNT = 20;   (* scenes = programs *)
    OPEN = 8;                                     (* event of the home buttons: val = the program's scene *)
    RANDURI = 20;                                 (* the bottom rows of the screen carry the sound *)

  VAR hold, bootFirst, nDown, nMoved: BOOLEAN; nx0, ny0: INTEGER; lZane2, now, lTasks, lCalc, lClock, lImages, lHelp, lFiles, lSet, lBoot, lApps, lCanvas, lTor, lP1, lCore, lSynth, lPlayer, lShell, lP2, W, H, bw: INTEGER; started: BOOLEAN; angle, tilt: REAL;
    bg, gold, white, grey, green, panel: INTEGER;

  PROCEDURE Pump(ev, val: INTEGER);   (* the sound, at the start and at the end of every frame *)
  BEGIN IF started THEN Synth9.Sunet END
  END Pump;

  PROCEDURE Tor(ev, val: INTEGER);   (* the Tor7 processes and their lines, in every frame *)
    VAR t0: INTEGER;
  BEGIN
    IF started THEN
      IF Sal4.Busy() THEN   (* 20000 instructions, and more while the programs want them, up to 8 ms of the frame *)
        t0 := Ceas.Ms(); Sal4.Run(20000);
        WHILE (Sal4.used = 20000) & (Ceas.Ms() - t0 < 8) DO Sal4.Run(20000) END
      END;
      Shell13.Pull; Gazda4.Poll; Zane4.MoTick; Zane4.PhTick
    END
  END Tor;

  PROCEDURE Centre(cx, y: INTEGER; s: ARRAY OF CHAR; m, c: INTEGER);
    VAR n: INTEGER;
  BEGIN
    n := 0; WHILE (n < LEN(s)) & (s[n] # 0X) DO INC(n) END;
    OllGL6.Text2D(cx - n * 3 * m, y, s, m, c)
  END Centre;

  PROCEDURE Open(scene: INTEGER);
  BEGIN
    now := scene; IF scene # BOOKS THEN Zane4.PbHide END; IF scene # VIDEO THEN Juno1.Hide END;   (* the page of the book stays only in its own screen *)
    IF scene = PLAYER THEN Synth9.IntraPlayer ELSIF scene = SHELL THEN Shell13.Enter
    ELSIF (scene = APPS) OR (scene = HOME) OR (scene = SETTINGS) THEN Desk6.Enter ELSIF scene = CANVAS THEN hold := TRUE
    ELSIF scene = FILES THEN Files14.Enter ELSIF scene = BOOT THEN Boot5.Start(W, H)
    ELSIF scene = TASKS THEN Zane4.PkEnter ELSIF scene = CALC THEN Zane4.MsEnter ELSIF scene = CLOCK THEN Zane4.MoEnter
    ELSIF scene = IMAGES THEN Zane4.IrEnter ELSIF scene = HELP THEN Zane4.RbEnter
    ELSIF scene = MUSIC THEN Zane4.PhEnter ELSIF scene = BOOKS THEN Zane4.PbEnter ELSIF scene = VIDEO THEN Juno1.Enter
    ELSIF scene = NOTES THEN Quince1.Enter ELSIF scene = RECORDER THEN Ceres1.Enter ELSIF scene = BROWSER THEN Nora18.Enter ELSIF scene = HUNT THEN Herne1.Enter
    END;
    Motor2.SchimbaScena(scene)
  END Open;

  PROCEDURE Act(r: INTEGER);   (* the actions of the desk: -1 HOME, 1 SYNTH, 2 PLAYER, 3 SHELL, 4 APPS, 5 CANVAS,
                                   6 FILES, 7 SETTINGS, 8 BOOT *)
  BEGIN
    IF r = -1 THEN Open(HOME) ELSIF r = 4 THEN Open(APPS) ELSIF r = 5 THEN Open(CANVAS) ELSIF r = 6 THEN Open(FILES)
    ELSIF r = 7 THEN Open(SETTINGS) ELSIF r = 8 THEN Open(BOOT) ELSIF (r >= 1) & (r <= 3) THEN Open(r)
    ELSIF (r >= 11) & (r <= 20) THEN Open(r - 2)   (* 11 TASKS .. 20 RECORDER are the scenes 9 .. 18 *)
    ELSIF r = 21 THEN Open(BROWSER) ELSIF r = 22 THEN Open(HUNT)
    END
  END Act;

  PROCEDURE Home;   (* the desktop: the cube under the clock, the card, the dock *)
    VAR x, y, z, l, r, cy: INTEGER; rr: REAL; tm: ARRAY 16 OF CHAR; sg: ARRAY 40 OF CHAR;
  BEGIN
    IF bootFirst THEN bootFirst := FALSE; IF Desk6.BootOn() THEN Open(BOOT) END END;
    OllGL6.Incepe(bg);
    IF ~Motor2.Jos() & Desk6.Spin() THEN angle := angle + Motor2.Pas() * 0.005 END;   (* turns by itself only when you do not hold it *)
    rr := 29.0 * Math.cos(tilt);
    OllGL6.Camera(rr * Math.cos(angle), 29.0 * Math.sin(tilt), rr * Math.sin(angle), 0.0, -0.6, 0.0, 50.0);
    OllGL6.Lumina(0.5);
    FOR x := 0 TO 6 DO FOR y := 0 TO 6 DO FOR z := 0 TO 6 DO
      IF Fs2.At(x, y, z) >= 0 THEN OllGL6.Cub(FLT(x - 3), FLT(y - 3), FLT(z - 3), 0.62, Desk6.Accent())   (* a file lives here *)
      ELSE OllGL6.Cub(FLT(x - 3), FLT(y - 3), FLT(z - 3), 0.34, OllGL6.RGB(30 + x * 18, 30 + y * 18, 50 + z * 18))
      END
    END END END;
    r := Desk6.Home(Motor2.Jos(), Motor2.X(), Motor2.Y());
    cy := H - 268; Desk6.Card(cy, 88);   (* the card: what Cubicum N is doing *)
    OllGL6.Text2D(44, cy + 16, "PI", 2, Desk6.Accent()); OllGL6.Text2D(44 + 24, cy + 16, "XIPOGO", 2, Desk6.text);
    IF Desk6.ShowFps() THEN OllGL6.Numar2D(W - 120, cy + 16, Motor2.Fps(), 2, grey); OllGL6.Text2D(W - 84, cy + 16, "FPS", 2, grey) END;
    l := Synth9.Locul();
    IF l > 0 THEN OllGL6.Text2D(44, cy + 54, "PLAYING SLOT", 2, green); OllGL6.Numar2D(44 + 13 * 12, cy + 54, l, 2, green)
    ELSIF Synth9.Canta() THEN OllGL6.Text2D(44, cy + 54, "THE SYNTH PLAYS", 2, green)
    ELSIF Zane4.PhPlaying(sg) THEN OllGL6.Text2D(44, cy + 54, sg, 2, green)   (* the song PHILOMEL sings *)
    ELSIF Zane4.MoRunning() THEN Zane4.MoLeft(tm); OllGL6.Text2D(44, cy + 54, "TIMER", 2, green); OllGL6.Text2D(44 + 6 * 12, cy + 54, tm, 2, green)
    ELSE OllGL6.Numar2D(44, cy + 54, Fs2.Count(), 2, white); OllGL6.Text2D(44 + 4 * 12, cy + 54, "FILES", 2, grey)
    END;
    OllGL6.Text2D(W - 270, cy + 54, "TOR7", 2, grey);
    FOR l := 0 TO 6 DO   (* the 7 turns of the spiral: gold = a program runs there *)
      IF Sal4.StateOf(l) # Sal4.Free THEN OllGL6.Rotund2D(W - 214 + l * 24, cy + 52, 18, 18, 4, Desk6.Accent())
      ELSE OllGL6.Rotund2D(W - 214 + l * 24, cy + 52, 18, 18, 4, panel)
      END
    END;
    OllGL6.Arata; Motor2.Arat;
    IF r # 0 THEN Act(r) END
  END Home;

  PROCEDURE Core(ev, val: INTEGER);
  BEGIN
    IF ev = Motor2.Scena THEN
      IF started THEN Fs2.Sync; Desk6.Enter END;   (* back home: the synth may have saved a song *)
      IF ~started THEN   (* first frame: now the window exists *)
        started := TRUE; W := Motor2.Latime(); H := Motor2.Inaltime() - RANDURI;
        OllGL6.Rezerva(RANDURI); Synth9.Porneste; Shell13.Start; Scr2.Size(W, H); bw := (W - 60) DIV 3;
        Desk6.Start(W, H); Files14.Start(W, H); bootFirst := TRUE;
        Zane4.PkStart(W, H); Zane4.MsStart(W, H); Zane4.MoStart(W, H); Zane4.IrStart(W, H); Zane4.RbStart(W, H); Zane4.ZnStart(W, H); Juno1.Start(W, H); Quince1.Start(W, H); Ceres1.Start(W, H); Nora18.Start(W, H); Herne1.Start(W, H)
      END
    ELSIF ev = OPEN THEN Open(val)
    ELSIF ev = Motor2.Trage THEN
      angle := angle + FLT(Motor2.DX()) * 0.012; tilt := tilt + FLT(Motor2.DY()) * 0.008;
      IF tilt > 1.3 THEN tilt := 1.3 ELSIF tilt < -1.3 THEN tilt := -1.3 END
    ELSIF ev = Motor2.Tick THEN Home
    END
  END Core;

  PROCEDURE Apps(ev, val: INTEGER);   (* the drawer: own programs, the tools, the host's apps *)
    VAR r: INTEGER; nm: ARRAY 40 OF CHAR; cmd: ARRAY 48 OF CHAR; i, j: INTEGER;
  BEGIN
    IF (ev = Motor2.Tick) & started THEN
      r := Desk6.Drawer(Motor2.Jos(), Motor2.X(), Motor2.Y()); Motor2.Arat;
      IF (r # 0) & (r # 10) THEN Act(r)
      ELSIF r = 10 THEN   (* a program of the cube: RUN it in the shell, and the shell shows what it says *)
        Desk6.Chosen(nm); cmd := "run "; i := 4; j := 0;
        WHILE (nm[j] # 0X) & (i < LEN(cmd) - 1) DO cmd[i] := nm[j]; INC(i); INC(j) END; cmd[i] := 0X;
        r := Shell13.Do(cmd); Open(SHELL)
      END
    END
  END Apps;

  PROCEDURE FilesScene(ev, val: INTEGER);
    VAR r: INTEGER;
  BEGIN
    IF (ev = Motor2.Tick) & started THEN
      r := Files14.Frame(Motor2.Jos(), Motor2.X(), Motor2.Y()); Motor2.Arat;
      IF r = 3 THEN Open(SHELL) ELSIF r # 0 THEN Act(r) END
    END
  END FilesScene;

  PROCEDURE SetScene(ev, val: INTEGER);
    VAR r: INTEGER;
  BEGIN
    IF (ev = Motor2.Tick) & started THEN
      r := Desk6.Settings(Motor2.Jos(), Motor2.X(), Motor2.Y()); Motor2.Arat;
      IF r # 0 THEN Act(r) END
    END
  END SetScene;

  PROCEDURE BootScene(ev, val: INTEGER);
  BEGIN
    IF (ev = Motor2.Tick) & started THEN
      IF Boot5.Frame(Motor2.Jos()) THEN Motor2.Arat; Open(HOME) ELSE Motor2.Arat END
    END
  END BootScene;

  PROCEDURE Tool(cur: INTEGER);   (* TASKS, CALC, CLOCK, IMAGES, HELP: each draws its screen and says where to go *)
    VAR r: INTEGER;
  BEGIN
    r := 0;
    IF cur = TASKS THEN r := Zane4.PkFrame(Motor2.Jos(), Motor2.X(), Motor2.Y())
    ELSIF cur = CALC THEN r := Zane4.MsFrame(Motor2.Jos(), Motor2.X(), Motor2.Y())
    ELSIF cur = CLOCK THEN r := Zane4.MoFrame(Motor2.Jos(), Motor2.X(), Motor2.Y())
    ELSIF cur = IMAGES THEN r := Zane4.IrFrame(Motor2.Jos(), Motor2.X(), Motor2.Y())
    ELSIF cur = HELP THEN r := Zane4.RbFrame(Motor2.Jos(), Motor2.X(), Motor2.Y())
    ELSIF cur = MUSIC THEN r := Zane4.PhFrame(Motor2.Jos(), Motor2.X(), Motor2.Y())
    ELSIF cur = BOOKS THEN r := Zane4.PbFrame(Motor2.Jos(), Motor2.X(), Motor2.Y())
    ELSIF cur = VIDEO THEN r := Juno1.Frame(Motor2.Jos(), Motor2.X(), Motor2.Y())
    ELSIF cur = NOTES THEN r := Quince1.Frame(Motor2.Jos(), Motor2.X(), Motor2.Y())
    ELSIF cur = RECORDER THEN r := Ceres1.Frame(Motor2.Jos(), Motor2.X(), Motor2.Y())
    ELSIF cur = BROWSER THEN r := Nora18.Frame(Motor2.Jos(), Motor2.X(), Motor2.Y())
    ELSIF cur = HUNT THEN r := Herne1.Frame(Motor2.Jos(), Motor2.X(), Motor2.Y())
    END;
    Motor2.Arat;
    IF r # 0 THEN Act(r) END
  END Tool;

  PROCEDURE TasksScene(ev, val: INTEGER); BEGIN IF (ev = Motor2.Tick) & started THEN Tool(TASKS) END END TasksScene;
  PROCEDURE CalcScene(ev, val: INTEGER); BEGIN IF (ev = Motor2.Tick) & started THEN Tool(CALC) END END CalcScene;
  PROCEDURE ClockScene(ev, val: INTEGER); BEGIN IF (ev = Motor2.Tick) & started THEN Tool(CLOCK) END END ClockScene;
  PROCEDURE ImagesScene(ev, val: INTEGER); BEGIN IF (ev = Motor2.Tick) & started THEN Tool(IMAGES) END END ImagesScene;
  PROCEDURE HelpScene(ev, val: INTEGER); BEGIN IF (ev = Motor2.Tick) & started THEN Tool(HELP) END END HelpScene;
  PROCEDURE Zane2Scene(ev, val: INTEGER);   (* one letter for both new fairies: fewer letters in Motor2 *)
  BEGIN IF (ev = Motor2.Tick) & started THEN IF (now >= BOOKS) & (now <= HUNT) THEN Tool(now) ELSE Tool(MUSIC) END END
  END Zane2Scene;

  PROCEDURE Synth(ev, val: INTEGER);
  BEGIN
    IF (ev = Motor2.Tick) & started THEN
      IF Synth9.Cadru(Motor2.Jos(), Motor2.X(), Motor2.Y()) THEN Motor2.SchimbaScena(HOME) END
    END
  END Synth;

  PROCEDURE Player(ev, val: INTEGER);
  BEGIN
    IF (ev = Motor2.Tick) & started THEN
      IF Synth9.Player(Motor2.Jos(), Motor2.X(), Motor2.Y()) THEN Motor2.SchimbaScena(HOME) END
    END
  END Player;

  PROCEDURE Canvas(ev, val: INTEGER);   (* what the Tor7 programs draw; their finger *)
    VAR x, y: INTEGER; inX: BOOLEAN;
  BEGIN
    IF (ev = Motor2.Tick) & started THEN
      x := Motor2.X(); y := Motor2.Y(); inX := (x >= W - 64) & (y < 52);
      IF hold & ~Motor2.Jos() THEN hold := FALSE END;
      Scr2.Touch(Motor2.Jos() & ~inX & ~hold, x, y);
      Scr2.Draw(bg);
      Grafica.Dreptunghi(W - 58, 6, 52, 40, panel); Grafica.Text(W - 38, 18, "X", 2, Grafica.RGB(239, 68, 68));
      IF Motor2.Jos() & inX THEN Motor2.SchimbaScena(SHELL) END
    END
  END Canvas;

  PROCEDURE Shell(ev, val: INTEGER);
    VAR r: INTEGER;
  BEGIN
    IF (ev = Motor2.Tick) & started THEN
      r := Shell13.Frame(Motor2.Jos(), Motor2.X(), Motor2.Y());
      IF r = -1 THEN Open(HOME) ELSIF r = 1 THEN Open(SYNTH) ELSIF r = 2 THEN Open(PLAYER)
      ELSIF (r = 3) OR Scr2.Fresh() THEN hold := TRUE; Motor2.SchimbaScena(CANVAS)   (* the finger on ENTER is not a touch *)
      END
    END
  END Shell;

BEGIN
  now := 0; hold := FALSE; nDown := FALSE; nMoved := FALSE; nx0 := 0; ny0 := 0; bootFirst := FALSE; started := FALSE; angle := 0.6; tilt := 0.39; W := 1; H := 1; bw := 150;
  bg := OllGL6.RGB(14, 4, 28); gold := OllGL6.RGB(212, 160, 23); white := OllGL6.RGB(240, 235, 250);
  grey := OllGL6.RGB(140, 130, 160); green := OllGL6.RGB(74, 222, 128); panel := OllGL6.RGB(52, 22, 86);
  Motor2.AutoPauza(FALSE);
  lP1 := Motor2.Litera("SOUND1", Pump, {Motor2.Tick});
  lTor := Motor2.Litera("TOR7", Tor, {Motor2.Tick});
  lCore := Motor2.Litera("CORE", Core, {Motor2.Tick, Motor2.Scena, Motor2.Trage, OPEN});
  Motor2.InScene(lCore, {HOME});
  lSynth := Motor2.Litera("SYNTH", Synth, {Motor2.Tick}); Motor2.InScene(lSynth, {SYNTH});
  lPlayer := Motor2.Litera("PLAYER", Player, {Motor2.Tick}); Motor2.InScene(lPlayer, {PLAYER});
  lShell := Motor2.Litera("SHELL", Shell, {Motor2.Tick}); Motor2.InScene(lShell, {SHELL});
  lCanvas := Motor2.Litera("CANVAS", Canvas, {Motor2.Tick}); Motor2.InScene(lCanvas, {CANVAS});
  lApps := Motor2.Litera("APPS", Apps, {Motor2.Tick}); Motor2.InScene(lApps, {APPS});
  lFiles := Motor2.Litera("FILES", FilesScene, {Motor2.Tick}); Motor2.InScene(lFiles, {FILES});
  lSet := Motor2.Litera("SETTINGS", SetScene, {Motor2.Tick}); Motor2.InScene(lSet, {SETTINGS});
  lBoot := Motor2.Litera("BOOT", BootScene, {Motor2.Tick}); Motor2.InScene(lBoot, {BOOT});
  lTasks := Motor2.Litera("TASKS", TasksScene, {Motor2.Tick}); Motor2.InScene(lTasks, {TASKS});
  lCalc := Motor2.Litera("CALC", CalcScene, {Motor2.Tick}); Motor2.InScene(lCalc, {CALC});
  lClock := Motor2.Litera("CLOCK", ClockScene, {Motor2.Tick}); Motor2.InScene(lClock, {CLOCK});
  lImages := Motor2.Litera("IMAGES", ImagesScene, {Motor2.Tick}); Motor2.InScene(lImages, {IMAGES});
  lHelp := Motor2.Litera("HELP", HelpScene, {Motor2.Tick}); Motor2.InScene(lHelp, {HELP});
  lZane2 := Motor2.Litera("ZANE2", Zane2Scene, {Motor2.Tick}); Motor2.InScene(lZane2, {MUSIC, BOOKS, VIDEO, NOTES, RECORDER, BROWSER, HUNT});
  lP2 := Motor2.Litera("SOUND2", Pump, {Motor2.Tick});
  Motor2.Ruleaza
END CubN51.
